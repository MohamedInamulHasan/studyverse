                    <div className={`h-full w-full bg-gradient-to-b ${selectedBook.themeColor || 'from-indigo-600 to-purple-800'} flex flex-col justify-between p-2 text-white text-center select-none`}>
                      <span className="text-[7px] font-black uppercase tracking-wider text-amber-300">
                        {selectedBook.term || "TN BOARD"}
                      </span>
                      <div className="my-auto py-1">
                        <h4 className="text-[10px] font-black leading-tight break-words">
                          {selectedBook.subject}
                        </h4>
                        {selectedBook.nativeTitle && (
                          <p className="text-[7.5px] font-bold text-white/90 mt-0.5 break-words">
                            {selectedBook.nativeTitle}
                          </p>
                        )}
                        {selectedBook.isCombined && (
                          <span className="inline-block mt-1 text-[5.5px] font-extrabold uppercase px-1 rounded bg-black/30 border border-white/20">
                            Combined Book
                          </span>
                        )}
                      </div>
                      <span className="text-[6.5px] font-semibold text-white/80">
                        {selectedBook.edition}
                      </span>
                    </div>
                  )}
                  {/* Spine Hinge & Binding Shadow */}
                  <div className="absolute left-0 top-0 bottom-0 w-3 bg-gradient-to-r from-black/60 via-black/25 to-transparent pointer-events-none z-10" />
                  <div className="absolute left-[2px] top-0 bottom-0 w-[1px] bg-white/40 pointer-events-none z-10" />
                  <div className="absolute left-[5px] top-0 bottom-0 w-[1px] bg-black/30 pointer-events-none z-10" />
                </div>
              </div>

              {/* Book Info & Action Button */}
              <div className="flex-1 min-w-0">
                <h2 className="text-xl font-black text-white leading-tight truncate">
                  {selectedBook.subject}
                </h2>

                <p className="text-xs font-bold text-white/80 mt-1 truncate">
                  {selectedBook.edition} â€¢ Tamil Nadu State Board
                </p>

                {/* View Button */}
                <button
                  onClick={() => setIsViewingBook(true)}
                  className="mt-3 inline-flex items-center gap-1.5 px-4 py-1.5 rounded-full bg-white hover:bg-slate-100 text-slate-900 text-xs font-extrabold transition active:scale-95"
