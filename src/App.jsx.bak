                                    {sub.title}
                                  </span>
                                </div>
                              </div>

                              {/* Right Side: circular chevron */}
                              <div className="flex items-center shrink-0 ml-2">
                                <div className="flex h-7 w-7 items-center justify-center rounded-full bg-white border border-slate-300 text-black shadow-2xs group-hover:scale-105 transition-all shrink-0">
                                  <ChevronRight className="h-3.5 w-3.5 stroke-[2.5]" />
                                </div>
                              </div>
                            </div>
