            >
              <ArrowLeft className="h-5 w-5" />
            </button>
          ) : selectedClass ? (
            <button
              onClick={() => {
                setSelectedClass(null);
                setSearchQuery('');
              }}
              className="flex h-10 w-10 items-center justify-center rounded-2xl bg-white shadow-xs text-slate-800 hover:bg-slate-50 transition active:scale-95"
            >
              <ArrowLeft className="h-5 w-5" />
            </button>
          ) : (
            <button className="flex h-10 w-10 items-center justify-center rounded-2xl text-slate-800 hover:bg-white/80 transition">
              <Menu className="h-6 w-6 stroke-[2.4]" />
            </button>
          )}

          {selectedUnit ? (
            <div className="flex flex-col items-center justify-center min-w-0 flex-1 px-1">
              <span className="text-sm sm:text-base font-black text-slate-900 tracking-tight text-center truncate max-w-[220px] leading-tight">
                {(() => {
                  const rawUnit = selectedUnit.unit || selectedUnit.title || '';
                  if (/^\d+$/.test(String(rawUnit).trim())) {
                    return (selectedBook?.subject || '').toLowerCase().includes('tamil')
                      ? `à®‡à®¯à®²à¯ ${rawUnit}`
                      : `Unit ${rawUnit}`;
                  }
                  return rawUnit;
                })()}
              </span>
              <span className="text-[11px] sm:text-xs font-semibold text-slate-500 text-center truncate max-w-[220px] leading-tight mt-0.5">
                {selectedUnit.sectionType ? `${selectedUnit.sectionType} : ` : ''}{selectedUnit.sectionTitle || selectedUnit.prose || selectedUnit.title}
              </span>
            </div>
          ) : (
            <h1 className="text-base font-black text-slate-900 tracking-tight text-center truncate max-w-[220px]">
              {selectedBook 
                ? selectedBook.subject 
                : selectedClass 
                  ? `${selectedClass.title} Textbooks` 
                  : "Select your Class/ Course"}
            </h1>
          )}

          {/* Right Spacer to keep center title balanced */}
          <div className="w-10 h-10 shrink-0" />
        </header>

        {/* ========================================================================= */}
        {/* SCREEN 1: 1 TO 12TH CARDS (HEAD POPS OUT TOP, ZERO BOTTOM GAP & OVERHANG)  */}
        {/* ========================================================================= */}
        {!selectedClass && (
          <main className="flex-1 overflow-y-auto px-5 pt-4 pb-28 space-y-4">
            
            {/* Modern Cylindrical Search Bar (Flat, No Light/Shadow Effects) */}
            <div className="relative group">
              <div className="flex items-center w-full rounded-full bg-white border border-black px-4 py-2.5 transition-colors">
                <Search className="h-4 w-4 stroke-[2.5] text-slate-800 shrink-0 mr-2.5" />
                <input
                  type="text"
                  value={searchQuery}
                  onChange={(e) => setSearchQuery(e.target.value)}
                  placeholder="Search standard (e.g. 10th, 12th, 6th)..."
