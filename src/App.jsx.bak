                  };

                  const hasSubtopics = chap.subtopics && chap.subtopics.length > 0;

                  if (!hasSubtopics) {
                    return (
                      <div
                        key={idx}
                        onClick={() => {
                          setSelectedUnit({
                            ...chap,
                            selectedSection: chap.title,
                            sectionTitle: chap.title,
                            sectionType: 'à®ªà®¾à®Ÿà®®à¯'
                          });
                          setActiveMarkTab(1);
                        }}
                        role="button"
                        tabIndex={0}
                        className={`group relative min-h-[58px] rounded-[20px] ${theme.cardBg || 'bg-white'} border ${theme.cardBorder || 'border-slate-200 border-b-[4px] border-b-slate-200'} ${theme.hoverBorder || 'hover:border-slate-300 hover:border-b-slate-300'} px-4 py-3 flex items-center justify-between cursor-pointer transition-all duration-150 active:translate-y-[2px] active:border-b-[2px] shadow-sm select-none`}
                      >
