                setTfAnswers({});
                setShowSectionSuggest({});
                setDialogueTypedAnswers({});
                setShowDialogueSuggest({});
                setDialogueRevealedPhases({});
                setSelectedSentenceGameAnswers({});
                setTypedSentences({});
